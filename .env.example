# No .env file is required for llm_provider: codex.

# Required only for direct Anthropic API mode.
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Required only for direct OpenAI API mode.
# OPENAI_API_KEY=<your-openai-api-key>

# Optional for local servers that expose an OpenAI Responses-compatible API.
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=dsv4-local
# OPENAI_TIMEOUT=120
